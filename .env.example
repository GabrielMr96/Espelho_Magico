# --- Obrigatório ---
# Uma ou mais chaves separadas por vírgula (rotação automática em caso de 429)
GEMINI_API_KEY=chave_1,chave_2

# --- IA (opcional) ---
# gemini (padrão) ou perplexity (com fallback para Gemini)
IA_PADRAO=gemini
# Sobrescreve a lista "gemini_models" do config.json (ordem = prioridade)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest
# GEMINI_MAX_OUTPUT_TOKENS=65536
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# Se o Gemini falhar em todos os modelos/rodadas, tenta o Perplexity como último recurso
# FALLBACK_PERPLEXITY=false

# --- Provedor alternativo fora do Google (fallback quando o Gemini dá 503 em tudo) ---
# Também pode ser o principal: IA_PADRAO=alt, ou só numa execução: --ia alt
# ALT_PROVEDOR: anthropic (Claude) | openai (OpenAI, OpenRouter, Groq...)
# ALT_MODELO: id exato do modelo no provedor
# ALT_BASE_URL: vazio = URL oficial; ex. OpenRouter: https://openrouter.ai/api/v1
# ALT_PROVEDOR=anthropic
# ALT_API_KEY=
# ALT_MODELO=
# ALT_BASE_URL=
# ALT_MAX_TOKENS=16000
# ALT_TIMEOUT=600
# FALLBACK_ALT=true

# --- Retentativas (param no que vier primeiro: MAX_RODADAS ou IA_TEMPO_MAX segundos) ---
# MAX_RODADAS=8
# BACKOFF_BASE=20
# BACKOFF_MAX=300
# IA_TEMPO_MAX=600
# Timeout por requisição ao Gemini, em segundos (evita esperar minutos por um 503)
# GEMINI_TIMEOUT=180

# --- Execução ---
# Grupos em paralelo (padrão: nº de chaves, até 3). Use 1 para o comportamento antigo.
# MAX_WORKERS=1
# Pausa entre grupos, em segundos (não ocorre depois do último)
# PAUSA_ENTRE_GRUPOS=15
# Converte o HTML para Markdown antes da IA (economiza tokens)
# HTML_PRECLEAN=true

# --- Google ---
# GMAIL_LABEL=Espelho_Magico
# ID da pasta de destino no Drive (vazio = raiz)
# DRIVE_FOLDER_ID=
# Pasta com token.json e credentials.json (ex.: fora do OneDrive)
# ESPELHO_SECRETS_DIR=C:\Users\voce\.espelho_magico

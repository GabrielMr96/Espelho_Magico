# --- Obrigatório ---
# Uma ou mais chaves separadas por vírgula (rotação automática em caso de 429)
GEMINI_API_KEY=chave_1,chave_2

# --- IA (opcional) ---
# gemini (padrão) ou perplexity (com fallback para Gemini)
IA_PADRAO=gemini
# Sobrescreve a lista "gemini_models" do config.json (ordem = prioridade)
# GEMINI_MODELS=gemini-4-hydrogen,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest,gemma-4-31b-it,gemma-4-26b-a4b-it
# GEMINI_MAX_OUTPUT_TOKENS=65536
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# Se o Gemini falhar em todos os modelos/rodadas, tenta o Perplexity como último recurso
# FALLBACK_PERPLEXITY=false

# --- Provedor alternativo fora do Google (opt-in; desativado por padrão) ---
# Também pode ser o principal: IA_PADRAO=alt, ou só numa execução: --ia alt
# ALT_PROVEDOR: anthropic (Claude) | openai (OpenAI, OpenRouter, Groq...)
# ALT_MODELO: id exato do modelo no provedor
# ALT_BASE_URL: vazio = URL oficial; ex. OpenRouter: https://openrouter.ai/api/v1
# ALT_PROVEDOR=anthropic
# ALT_API_KEY=
# ALT_MODELO=
# ALT_BASE_URL=
# ALT_MAX_TOKENS=16000
# ALT_TIMEOUT=600
# FALLBACK_ALT=false

# --- Retentativas (param no que vier primeiro: MAX_RODADAS ou IA_TEMPO_MAX segundos) ---
# MAX_RODADAS=8
# BACKOFF_BASE=20
# BACKOFF_MAX=300
# IA_TEMPO_MAX=900
# Timeout por requisição ao Gemini, em segundos (evita esperar minutos por um 503/504)
# GEMINI_TIMEOUT=90
# Pausa curta (s) para tentar novamente modelos principais em picos de 503 antes de baixar para lite/gemma
# PAUSA_ANTES_DOWNGRADE=6
# Segunda passagem seletiva (reextrai partes rebaixadas + auditoria estrutural compacta pós-fatiamento)
# DUPLA_PASSAGEM_REVISAO=true

# --- Execução ---
# Grupos em paralelo (padrão: nº de chaves, até 3). Use 1 para o comportamento antigo.
# MAX_WORKERS=1
# Pausa entre grupos, em segundos (não ocorre depois do último)
# PAUSA_ENTRE_GRUPOS=15
# Converte o HTML para Markdown antes da IA (economiza tokens)
# HTML_PRECLEAN=true
# Tamanho máximo (em caracteres) por requisição à IA antes de fatiar por seções (evita 504 e 413)
# MAX_CHARS_POR_CHAMADA=7500
# Dupla verificação automática nos sites oficiais quando um e-mail não chega no Gmail
# VERIFICAR_FONTES_WEB=true

# --- Google ---
# GMAIL_LABEL=Espelho_Magico
# ID da pasta de destino no Drive (vazio = raiz)
# DRIVE_FOLDER_ID=
# Pasta com token.json e credentials.json (ex.: fora do OneDrive)
# ESPELHO_SECRETS_DIR=C:\Users\voce\.espelho_magico
